    {
        "id": "5b95ba505dfa100c",
        "type": "function",
        "z": "513057e9f0e4f19f",
        "name": "Convertir pour Influx",
        "func": "let data;\nif (typeof msg.payload === 'string') {\n    try {\n        data = JSON.parse(msg.payload);\n    } catch (e) {\n        node.error(\"Erreur de parsing JSON : \" + e.message);\n        return null;\n    }\n} else {\n    data = msg.payload;\n}\n\nif (!data || !data.type || !data.sensor_id || data.value === undefined) {\n    node.error(\"Payload incomplet : \" + JSON.stringify(data));\n    return null;\n}\n\nlet measurement = data.type;\nlet tags = `sensor_id=${data.sensor_id}`;\nlet fields = `value=${data.value}`;\nlet timestamp = Math.floor(new Date(data.timestamp).getTime() * 1000000);\nmsg.payload = `${measurement},${tags} ${fields} ${timestamp}`;\nmsg.headers = {\"Authorization\": \"Token mon-token-secret-123\"};\nmsg.url = \"http://172.22.0.10:8086/api/v2/write?org=iot-lab&bucket=iot_data&precision=ns\";\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 320,
        "wires": [
            [
                "a4c9b5abf307af46"
            ]
        ]
    },
