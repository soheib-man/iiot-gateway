    {
        "id": "fb11df49cd4b9fe7",
        "type": "function",
        "z": "513057e9f0e4f19f",
        "name": "preparer sync",
        "func": "\nif (!msg.payload || msg.payload.length === 0) {\n    return null;\n}\n\nlet messages = [];\n\nmsg.payload.forEach(row => {\n\n    let data = JSON.parse(row.payload);\n\n    let newMsg = {\n        payload: data,\n        buffer_id: row.id\n    };\n\n    messages.push(newMsg);\n});\n\nreturn [messages];\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 280,
        "y": 280,
        "wires": [
            [
                "5b95ba505dfa100c",
                "82c53e5903e1bd44"
            ]
        ]
    },
    {
        "id": "6dca859cff4dbcd5",
        "type": "function",
        "z": "513057e9f0e4f19f",
        "name": "marquuer sync",
        "func": "if (msg.buffer_id === undefined) {\n    return null;\n}\n\nmsg.topic =\n    \"UPDATE buffer SET synced = 1 WHERE id = \" + msg.buffer_id;\n\nnode.warn(\"REQUETE SQL = \" + msg.topic);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
